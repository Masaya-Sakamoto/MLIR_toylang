# =================================================================
# Stage 6: mlir-dev (クリーンな最終イメージ)
# =================================================================
FROM mlir-base:latest AS mlir-dev
FROM debian:trixie-slim AS base
# RUN apt-get... (baseからランタイムライブラリのみコピーしても良い)
ENV LLVM_VERSION="21.x"
ENV LLVM_INSTALL_PREFIX="/usr/local/llvm-${LLVM_VERSION}"
ENV PATH="${LLVM_INSTALL_PREFIX}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${LLVM_INSTALL_PREFIX}/lib:${LD_LIBRARY_PATH}"

# mlir-base *から* インストール結果のみコピー
COPY --from=mlir-base ${LLVM_INSTALL_PREFIX} ${LLVM_INSTALL_PREFIX}
WORKDIR /work